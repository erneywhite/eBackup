{
  "id": "minecraft-java",
  "displayName": "Minecraft (Java Edition)",
  "minApiVersion": "1.0",
  "entries": [
    {
      "tokenPath": "{APPDATA}/.minecraft",
      "type": "Directory",
      "archivePath": "vanilla",
      "excludeGlobs": [
        "assets/**",
        "versions/**",
        "libraries/**",
        "bin/**",
        "logs/**",
        "crash-reports/**",
        "**/*.log"
      ]
    },
    {
      "tokenPath": "{USERPROFILE}/curseforge/minecraft/Instances",
      "type": "Directory",
      "archivePath": "curseforge",
      "excludeGlobs": [
        "**/logs/**",
        "**/crash-reports/**",
        "**/.mixin.out/**",
        "**/downloads/**",
        "**/*.log"
      ]
    },
    {
      "tokenPath": "{APPDATA}/PrismLauncher/instances",
      "type": "Directory",
      "archivePath": "prism",
      "excludeGlobs": [
        "**/logs/**",
        "**/crash-reports/**",
        "**/.mixin.out/**",
        "**/*.log"
      ]
    },
    {
      "tokenPath": "{APPDATA}/ModrinthApp/profiles",
      "type": "Directory",
      "archivePath": "modrinth",
      "excludeGlobs": [
        "**/logs/**",
        "**/crash-reports/**",
        "**/*.log"
      ]
    }
  ]
}
