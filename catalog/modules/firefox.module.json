{
  "id": "firefox",
  "displayName": "Mozilla Firefox",
  "minApiVersion": "1.0",
  "entries": [
    {
      "tokenPath": "{APPDATA}/Mozilla/Firefox",
      "type": "Directory",
      "archivePath": "profile",
      "excludeGlobs": [
        "Crash Reports/**",
        "Pending Pings/**",
        "Background Tasks Profiles/**",
        "**/datareporting/**",
        "**/crashes/**",
        "**/gmp-*/**",
        "**/shader-cache/**",
        "**/startupCache/**",
        "**/security_state/**",
        "**/*.log",
        "**/lock",
        "**/.parentlock"
      ]
    }
  ]
}
