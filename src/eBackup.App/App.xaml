<Application
    x:Class="eBackup.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- Тёмная тема (ключ Default). Системный акцент Windows (синий) →
                     наш виолет: чекбоксы, тогглы, радио, слайдеры, ссылки,
                     выделение текста. Перекрываем и цвета, и ключевые кисти —
                     WinAppSDK местами берёт акцент напрямую из ОС. -->
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="SystemAccentColor">#C97DF6</Color>
                    <Color x:Key="SystemAccentColorLight1">#C97DF6</Color>
                    <Color x:Key="SystemAccentColorLight2">#C97DF6</Color>
                    <Color x:Key="SystemAccentColorLight3">#E3BDFB</Color>
                    <Color x:Key="SystemAccentColorDark1">#A75BD0</Color>
                    <Color x:Key="SystemAccentColorDark2">#9650BD</Color>
                    <Color x:Key="SystemAccentColorDark3">#7E3FA0</Color>

                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#C97DF6" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6C97DF6" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCC97DF6" />
                    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#C97DF6" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#E3BDFB" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E3BDFB" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#C97DF6" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#99C97DF6" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Палитра eBackup (в стиле eCoda) -->
            <Color x:Key="EbBackgroundColor">#0E0A16</Color>
            <Color x:Key="EbAccent1">#C97DF6</Color>
            <Color x:Key="EbAccent2">#FF6DC8</Color>

            <SolidColorBrush x:Key="EbBackgroundBrush" Color="{StaticResource EbBackgroundColor}" />
            <SolidColorBrush x:Key="EbCardBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="EbCardBorderBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="EbTextDimBrush" Color="#9AA0AC" />
            <SolidColorBrush x:Key="EbDialogBrush" Color="#171022" />
            <SolidColorBrush x:Key="EbOkBrush" Color="#7CE3A8" />
            <SolidColorBrush x:Key="EbErrBrush" Color="#FF8A9C" />

            <LinearGradientBrush x:Key="EbAccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource EbAccent1}" Offset="0" />
                <GradientStop Color="{StaticResource EbAccent2}" Offset="1" />
            </LinearGradientBrush>

            <!-- Карточка-секция страницы -->
            <Style x:Key="EbSectionCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="{StaticResource EbCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource EbCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="18,14" />
            </Style>

            <!-- Градиентная кнопка: свой шаблон, потому что стандартный на hover/нажатии
                 подменяет фон системной кистью и градиент пропадает. Здесь градиент
                 остаётся, поверх — белая вуаль при наведении и тёмная при нажатии. -->
            <Style x:Key="EbAccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource EbAccentGradient}" />
                <Setter Property="Foreground" Value="#1A0F22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="11,5,11,6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverVeil"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.12" Duration="0:0:0.10" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PressVeil"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.16" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.45" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="HoverVeil" Background="#FFFFFF" Opacity="0"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        IsHitTestVisible="False" />
                                <Border x:Name="PressVeil" Background="#000000" Opacity="0"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        IsHitTestVisible="False" />
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Padding="{TemplateBinding Padding}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Кнопки диалогов в фирменном стиле -->
            <Style x:Key="EbDialogPrimaryStyle" TargetType="Button"
                   BasedOn="{StaticResource EbAccentButtonStyle}" />
            <Style x:Key="EbDialogCloseStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{StaticResource EbCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource EbCardBorderBrush}" />
            </Style>

            <!-- Пилюля-таб сайдбара: нормальное скругление + виолетовая подсветка выделения -->
            <Style x:Key="EbNavItemStyle" TargetType="ListViewItem">
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ListViewItemPresenter
                                CornerRadius="12"
                                ContentMargin="12,0"
                                VerticalContentAlignment="Center"
                                SelectionCheckMarkVisualEnabled="False"
                                SelectionIndicatorVisualEnabled="False"
                                PointerOverBackground="#12FFFFFF"
                                PressedBackground="#1CFFFFFF"
                                SelectedBackground="#2BC97DF6"
                                SelectedPointerOverBackground="#36C97DF6"
                                SelectedPressedBackground="#40C97DF6"
                                ContentTransitions="{TemplateBinding ContentTransitions}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
