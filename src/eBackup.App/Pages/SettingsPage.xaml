<Page
    x:Class="eBackup.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="660" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" FontSize="26" FontWeight="SemiBold" />

            <TextBlock Text="Папки для архивов (включая сетевые диски) настраиваются на странице «Хранилища»."
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource EbTextDimBrush}" />

            <!-- Хранение версий -->
            <Border Style="{StaticResource EbSectionCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Хранение версий" FontSize="12"
                               Foreground="{StaticResource EbTextDimBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Хранить последних" VerticalAlignment="Center" />
                        <TextBox x:Name="RetentionBox" Width="80" Text="0" />
                        <TextBlock Text="архивов" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="0 — хранить все. Правило применяется после каждого бэкапа: и в локальной папке, и на серверах, куда заливался архив (старые удаляются автоматически)."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource EbTextDimBrush}" />
                </StackPanel>
            </Border>

            <!-- Поведение: трей и автозапуск -->
            <Border Style="{StaticResource EbSectionCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Поведение" FontSize="12"
                               Foreground="{StaticResource EbTextDimBrush}" />
                    <ToggleSwitch x:Name="TrayToggle"
                                  OnContent="Сворачивать в трей при закрытии окна"
                                  OffContent="Сворачивать в трей при закрытии окна" />
                    <ToggleSwitch x:Name="AutostartToggle"
                                  OnContent="Запускать вместе с Windows (свёрнуто, в трее)"
                                  OffContent="Запускать вместе с Windows (свёрнуто, в трее)" />
                    <TextBlock Text="В трее расписания продолжают работать; полный выход — через меню иконки в трее."
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource EbTextDimBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SaveBtn" Height="42" Padding="28,0" CornerRadius="21"
                        Style="{StaticResource EbAccentButtonStyle}"
                        Click="SaveBtn_Click">
                    <TextBlock Text="Сохранить" FontWeight="SemiBold" Foreground="#1A0F22" />
                </Button>
                <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Позже здесь появятся: язык интерфейса и другие настройки."
                       FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{StaticResource EbTextDimBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
