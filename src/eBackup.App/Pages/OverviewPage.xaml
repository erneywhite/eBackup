<Page
    x:Class="eBackup.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16">
            <TextBlock Text="Обзор" FontSize="26" FontWeight="SemiBold" />

            <ItemsControl>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <Border Width="210" Height="120" CornerRadius="16"
                        Background="{StaticResource EbCardBrush}"
                        BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                        Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="OBS Studio" FontWeight="SemiBold" />
                        <TextBlock Text="встроенный модуль" FontSize="12"
                                   Foreground="{StaticResource EbTextDimBrush}" />
                        <TextBlock Text="✓ включён" FontSize="12" Foreground="#7CE3A8" />
                    </StackPanel>
                </Border>

                <Border Width="210" Height="120" CornerRadius="16"
                        Background="{StaticResource EbCardBrush}"
                        BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                        Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="NAS (SFTP)" FontWeight="SemiBold" />
                        <TextBlock Text="хранилище" FontSize="12"
                                   Foreground="{StaticResource EbTextDimBrush}" />
                        <TextBlock Text="✓ подключено" FontSize="12" Foreground="#7CE3A8" />
                    </StackPanel>
                </Border>

                <Border Width="120" Height="120" CornerRadius="16"
                        Background="Transparent"
                        BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                        Padding="16">
                    <TextBlock Text="+" FontSize="34" HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource EbTextDimBrush}" />
                </Border>
            </ItemsControl>

            <TextBlock Text="(заглушка — живой дашборд подключим после экранов Хранилищ и Модулей)"
                       FontSize="12" Foreground="{StaticResource EbTextDimBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
