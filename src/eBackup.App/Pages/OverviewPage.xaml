<Page
    x:Class="eBackup.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- Плитка-кнопка дашборда в стиле карточек -->
        <Style x:Key="EbTileStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{StaticResource EbCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EbCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller">
        <!-- Контент тянется на всю ширину окна (выбор пользователя: не пустовато). -->
        <StackPanel x:Name="ContentPanel" Spacing="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Обзор" FontSize="26" FontWeight="SemiBold" />
                <Button x:Name="RefreshBtn" Grid.Column="1" CornerRadius="10" Padding="9,7"
                        VerticalAlignment="Center" Click="RefreshBtn_Click"
                        ToolTipService.ToolTip="Обновить дашборд и проверить все хранилища">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
            </Grid>

            <!-- Последний бэкап -->
            <Button x:Name="LastBackupCard" Style="{StaticResource EbTileStyle}"
                    HorizontalAlignment="Stretch" Click="GoArchives_Click">
                <StackPanel Spacing="4">
                    <TextBlock Text="Последний бэкап" FontSize="12"
                               Foreground="{StaticResource EbTextDimBrush}" />
                    <TextBlock x:Name="LastBackupTitle" FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" Text="…" />
                    <TextBlock x:Name="LastBackupSub" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource EbTextDimBrush}" />
                </StackPanel>
            </Button>

            <!-- Плитки: архивы и модули. Звёздные колонки — сжимаются вместе с окном,
                 а не обрезаются (как было с фиксированной шириной). -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ArchivesTile" Style="{StaticResource EbTileStyle}"
                        Grid.Column="0" MinHeight="96" HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" Click="GoArchives_Click">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Архивы" FontWeight="SemiBold" />
                        <TextBlock x:Name="ArchivesTileText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource EbTextDimBrush}" Text="…" />
                    </StackPanel>
                </Button>

                <Button x:Name="ModulesTile" Style="{StaticResource EbTileStyle}"
                        Grid.Column="1" MinHeight="96" HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" Click="GoModules_Click">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Модули" FontWeight="SemiBold" />
                        <TextBlock x:Name="ModulesTileText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource EbTextDimBrush}" Text="…" />
                    </StackPanel>
                </Button>

                <Button x:Name="ScheduleTile" Style="{StaticResource EbTileStyle}"
                        Grid.Column="2" MinHeight="96" HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" Click="GoSchedule_Click">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Расписание" FontWeight="SemiBold" />
                        <TextBlock x:Name="ScheduleTileText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource EbTextDimBrush}" Text="…" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Хранилища с живыми статусами -->
            <Button x:Name="StorageTile" Style="{StaticResource EbTileStyle}"
                    HorizontalAlignment="Stretch" Click="GoStorage_Click">
                <StackPanel Spacing="6">
                    <TextBlock Text="Хранилища" FontWeight="SemiBold" />
                    <StackPanel x:Name="StorageRows" Spacing="4" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
