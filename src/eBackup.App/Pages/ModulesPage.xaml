<Page
    x:Class="eBackup.App.Pages.ModulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <!-- ===== Левая часть: карточки модулей ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Модули" FontSize="26" FontWeight="SemiBold" />
                <Button x:Name="ImportBtn" Grid.Column="1" CornerRadius="10" Padding="14,7"
                        VerticalAlignment="Center" Click="ImportBtn_Click">
                    <TextBlock Text="+ Импорт модуля" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="10">
                    <VariableSizedWrapGrid x:Name="CardsPanel" Orientation="Horizontal" />
                    <TextBlock x:Name="HintText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource EbTextDimBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Правая часть: деталь выбранного модуля ===== -->
        <Grid Grid.Column="1">
            <TextBlock x:Name="EmptyHint" Text="Выбери модуль слева"
                       Foreground="{StaticResource EbTextDimBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <Border x:Name="Detail" Visibility="Collapsed" CornerRadius="16"
                    Background="{StaticResource EbCardBrush}"
                    BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                    Padding="20" VerticalAlignment="Top">
                <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailMeta" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource EbTextDimBrush}" />
                        <TextBlock x:Name="DetailStatus" FontSize="12" TextWrapping="Wrap" />

                        <!-- Выключатель участия в бэкапах (на восстановление не влияет) -->
                        <ToggleSwitch x:Name="EnableToggle" Margin="0,4,0,0"
                                      OnContent="участвует в бэкапах"
                                      OffContent="выключен из бэкапов"
                                      Toggled="EnableToggle_Toggled" />

                        <TextBlock Text="Что бэкапит" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{StaticResource EbTextDimBrush}" />
                        <StackPanel x:Name="DetailEntries" Spacing="4" />

                        <Button x:Name="DeleteModuleBtn" Visibility="Collapsed" Margin="0,12,0,0"
                                CornerRadius="10" Padding="14,7" Click="DeleteModuleBtn_Click"
                                Foreground="{StaticResource EbErrBrush}">
                            <TextBlock Text="Удалить модуль" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
