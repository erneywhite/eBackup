<Page
    x:Class="eBackup.App.Pages.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <SolidColorBrush x:Key="EbErrBrush" Color="#FF8A9C" />
        <Style x:Key="EbSectionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{StaticResource EbCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EbCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,14" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="660" HorizontalAlignment="Left">
            <TextBlock Text="Восстановление" FontSize="26" FontWeight="SemiBold" />

            <!-- Архив -->
            <Border Style="{StaticResource EbSectionCard}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Архив" FontSize="12" Foreground="{StaticResource EbTextDimBrush}" />
                    <TextBlock x:Name="ArchiveName" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ArchiveSourceText" FontSize="12"
                               Foreground="{StaticResource EbTextDimBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Куда восстановить -->
            <Border Style="{StaticResource EbSectionCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Куда восстановить" FontSize="12"
                               Foreground="{StaticResource EbTextDimBrush}" />
                    <RadioButton x:Name="OriginalRadio" GroupName="dest" IsChecked="True"
                                 Content="В исходные места (туда, откуда бэкапилось)"
                                 Checked="DestMode_Changed" />
                    <RadioButton x:Name="FolderRadio" GroupName="dest"
                                 Content="В отдельную папку" Checked="DestMode_Changed" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetDirBox" IsEnabled="False"
                                 PlaceholderText="путь к папке для распаковки" />
                        <Button x:Name="PickTargetBtn" Grid.Column="1" Content="Выбрать…"
                                CornerRadius="10" IsEnabled="False" Click="PickTargetBtn_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Конфликты -->
            <Border Style="{StaticResource EbSectionCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Если файл уже существует" FontSize="12"
                               Foreground="{StaticResource EbTextDimBrush}" />
                    <RadioButton x:Name="BakRadio" GroupName="conflict" IsChecked="True"
                                 Content="Заменять, старый переименовывать в .bak (безопасно)" />
                    <RadioButton x:Name="OverwriteRadio" GroupName="conflict"
                                 Content="Перезаписывать" />
                    <RadioButton x:Name="SkipRadio" GroupName="conflict"
                                 Content="Дополнять — записывать только недостающие" />
                </StackPanel>
            </Border>

            <!-- Парольная фраза -->
            <Border Style="{StaticResource EbSectionCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Шифрование" FontSize="12"
                               Foreground="{StaticResource EbTextDimBrush}" />
                    <TextBlock x:Name="PassHint" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource EbTextDimBrush}" />
                    <PasswordBox x:Name="PassBox" PlaceholderText="парольная фраза"
                                 MaxWidth="380" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Ассеты -->
            <Border Style="{StaticResource EbSectionCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Папка для ассетов модулей (например, медиа сцен OBS)"
                               FontSize="12" Foreground="{StaticResource EbTextDimBrush}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AssetsDirBox" />
                        <Button x:Name="PickAssetsBtn" Grid.Column="1" Content="Выбрать…"
                                CornerRadius="10" Click="PickAssetsBtn_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource EbErrBrush}" Visibility="Collapsed" />

            <Button x:Name="LaunchBtn" Height="46" Padding="32,0" CornerRadius="23"
                    Background="{StaticResource EbAccentGradient}" BorderThickness="0"
                    Click="LaunchBtn_Click" Margin="0,4,0,16">
                <TextBlock Text="Восстановить" FontWeight="SemiBold" Foreground="#1A0F22" />
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
