<Page
    x:Class="eBackup.App.Pages.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:eBackup.App.Pages">

    <Page.Resources>
        <SolidColorBrush x:Key="EbOkBrush" Color="#7CE3A8" />
        <SolidColorBrush x:Key="EbErrBrush" Color="#FF8A9C" />
    </Page.Resources>

    <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Левая панель: список хранилищ ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Хранилища" FontSize="26" FontWeight="SemiBold" />
                <Button x:Name="RefreshBtn" Grid.Column="1" CornerRadius="10" Padding="9,7"
                        VerticalAlignment="Center" Click="RefreshBtn_Click"
                        ToolTipService.ToolTip="Проверить доступность всех хранилищ">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
            </Grid>

            <ListView x:Name="StorageList" Grid.Row="1" SelectionMode="Single"
                      SelectionChanged="StorageList_SelectionChanged"
                      ItemContainerStyle="{StaticResource EbNavItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="pages:StorageItem">
                        <Grid Margin="0,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource EbTextDimBrush}" />
                            </StackPanel>
                            <!-- Селф-тест: ✓ доступно / ✕ недоступно / … проверяется -->
                            <TextBlock Grid.Column="1" Text="{x:Bind StatusGlyph, Mode=OneWay}"
                                       Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:Name="AddBtn" Grid.Row="2" HorizontalAlignment="Stretch"
                    Margin="0,10,0,0" CornerRadius="12">
                <TextBlock Text="+ Добавить хранилище" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Папка или сетевой диск" Click="AddFolder_Click" />
                        <MenuFlyoutItem Text="SFTP-сервер" Click="AddSftp_Click" />
                        <MenuFlyoutItem Text="FTP / FTPS-сервер" Click="AddFtp_Click" />
                        <MenuFlyoutItem Text="S3-совместимое (AWS, MinIO, B2, R2…)" Click="AddS3_Click" />
                        <MenuFlyoutItem Text="WebDAV (Nextcloud, Яндекс.Диск…)" Click="AddWebDav_Click" />
                        <MenuFlyoutItem Text="Google Drive" Click="AddGDrive_Click" />
                        <MenuFlyoutItem Text="Dropbox" Click="AddDropbox_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- ===== Правая панель: редактор ===== -->
        <Grid Grid.Column="1">
            <TextBlock x:Name="EmptyHint"
                       Text="Выбери хранилище слева или добавь новое"
                       Foreground="{StaticResource EbTextDimBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <Border x:Name="Editor" Visibility="Collapsed" CornerRadius="16"
                    Background="{StaticResource EbCardBrush}"
                    BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                    Padding="20" VerticalAlignment="Top">
                <ScrollViewer MaxHeight="580" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="EditorTitle" Text="Новое хранилище"
                                   FontSize="18" FontWeight="SemiBold" />

                        <TextBlock Text="Название" FontSize="12"
                                   Foreground="{StaticResource EbTextDimBrush}" />
                        <TextBox x:Name="NameBox" PlaceholderText="имя хранилища — как будет показано в списке" />

                        <!-- ===== Папка / сетевой диск ===== -->
                        <StackPanel x:Name="FolderPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Путь к папке" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PathBox"
                                         PlaceholderText="D:\Backups, Z:\… или \\nas\share\backups" />
                                <Button x:Name="BrowsePathBtn" Grid.Column="1" Content="Обзор…"
                                        CornerRadius="10" Click="BrowsePathBtn_Click" />
                            </Grid>

                            <TextBlock Text="Авторизация для сетевой папки (если требуется; подключение временное — в системе не сохраняется)"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource EbTextDimBrush}" Margin="0,4,0,0" />
                            <TextBox x:Name="ShareUserBox"
                                     PlaceholderText="логин (например, nas\user или user)" />
                            <PasswordBox x:Name="SharePassBox" PlaceholderText="пароль" />
                        </StackPanel>

                        <!-- ===== Google Drive ===== -->
                        <StackPanel x:Name="GDrivePanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Аккаунт Google" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="GDriveLoginBtn" Content="Войти через браузер…"
                                        CornerRadius="10" Click="GDriveLogin_Click" />
                                <TextBlock x:Name="GDriveStatus" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Папка на Диске" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <TextBox x:Name="GDriveFolderBox" PlaceholderText="eBackup" />
                            <TextBlock Text="Приложение видит только собственные файлы (scope drive.file) — к остальному содержимому Диска доступа нет."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                        </StackPanel>

                        <!-- ===== Dropbox ===== -->
                        <StackPanel x:Name="DropboxPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Аккаунт Dropbox" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="DropboxLoginBtn" Content="Войти через браузер…"
                                        CornerRadius="10" Click="DropboxLogin_Click" />
                                <TextBlock x:Name="DropboxStatus" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Подпапка (внутри Apps/папки приложения)" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <TextBox x:Name="DropboxFolderBox" PlaceholderText="пусто — корень папки приложения" />
                            <TextBlock Text="Доступ ограничен изолированной папкой Apps — остальной Dropbox приложению не виден."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                        </StackPanel>

                        <!-- ===== WebDAV ===== -->
                        <StackPanel x:Name="WebDavPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Базовый URL" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <TextBox x:Name="WebDavUrlBox"
                                     PlaceholderText="https://webdav.yandex.ru или https://сервер/remote.php/dav/files/логин" />

                            <TextBlock Text="Папка для архивов" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <TextBox x:Name="WebDavDirBox" PlaceholderText="например: backups/eBackup (пусто — корень)" />

                            <TextBlock Text="Логин" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <TextBox x:Name="WebDavUserBox" PlaceholderText="имя пользователя" />

                            <PasswordBox x:Name="WebDavPassBox" PlaceholderText="пароль" />
                            <TextBlock Text="Для Яндекс.Диска используй «пароль приложения» (создаётся в настройках Яндекс ID), для Nextcloud — пароль приложения из настроек безопасности."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                        </StackPanel>

                        <!-- ===== S3-совместимое ===== -->
                        <StackPanel x:Name="S3Panel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Endpoint" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <TextBox x:Name="S3UrlBox"
                                     PlaceholderText="https://s3.eu-central-1.amazonaws.com или адрес MinIO/B2/R2" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <TextBlock Text="Бакет" FontSize="12"
                                               Foreground="{StaticResource EbTextDimBrush}" />
                                    <TextBox x:Name="S3BucketBox" PlaceholderText="my-backups" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <TextBlock Text="Папка в бакете (префикс)" FontSize="12"
                                               Foreground="{StaticResource EbTextDimBrush}" />
                                    <TextBox x:Name="S3PrefixBox" PlaceholderText="пусто — корень бакета" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Access Key ID" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <TextBox x:Name="S3AccessBox" PlaceholderText="ключ доступа" />

                            <PasswordBox x:Name="S3SecretBox" PlaceholderText="Secret Access Key" />

                            <CheckBox x:Name="S3PathStyleCheck" IsChecked="True"
                                      Content="Path-style адресация (нужна MinIO/B2/R2; для AWS можно снять)" />
                        </StackPanel>

                        <!-- ===== FTP / FTPS ===== -->
                        <StackPanel x:Name="FtpPanel" Spacing="10" Visibility="Collapsed">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <TextBlock Text="Хост / IP" FontSize="12"
                                               Foreground="{StaticResource EbTextDimBrush}" />
                                    <TextBox x:Name="FtpHostBox" PlaceholderText="адрес сервера (домен или IP)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <TextBlock Text="Порт" FontSize="12"
                                               Foreground="{StaticResource EbTextDimBrush}" />
                                    <TextBox x:Name="FtpPortBox" Text="21" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Логин" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <TextBox x:Name="FtpUserBox" PlaceholderText="имя пользователя на сервере" />

                            <PasswordBox x:Name="FtpPassBox" PlaceholderText="пароль" />

                            <TextBlock Text="Удалённая папка для архивов" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <TextBox x:Name="FtpDirBox" Text="." />

                            <CheckBox x:Name="FtpsCheck" Content="FTPS — шифровать соединение (TLS)" />
                            <TextBlock Text="Сертификат сервера не проверяется строго (подходит для NAS с самоподписанным). Для архивов со стрим-ключами включай шифрование самого архива."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                        </StackPanel>

                        <!-- ===== SFTP ===== -->
                        <StackPanel x:Name="SftpPanel" Spacing="10" Visibility="Collapsed">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <TextBlock Text="Хост / IP" FontSize="12"
                                               Foreground="{StaticResource EbTextDimBrush}" />
                                    <TextBox x:Name="HostBox" PlaceholderText="адрес сервера (домен или IP)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <TextBlock Text="Порт" FontSize="12"
                                               Foreground="{StaticResource EbTextDimBrush}" />
                                    <TextBox x:Name="PortBox" Text="22" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Логин" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                            <TextBox x:Name="UserBox" PlaceholderText="имя пользователя на сервере" />

                            <TextBlock Text="Аутентификация" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <RadioButton x:Name="AuthPassword" Content="Пароль" GroupName="auth"
                                             IsChecked="True" Checked="AuthMode_Changed" />
                                <RadioButton x:Name="AuthKey" Content="SSH-ключ" GroupName="auth"
                                             Checked="AuthMode_Changed" />
                            </StackPanel>

                            <StackPanel x:Name="PasswordPanel" Spacing="10">
                                <PasswordBox x:Name="PassBox" PlaceholderText="пароль" />
                            </StackPanel>

                            <StackPanel x:Name="KeyPanel" Spacing="10" Visibility="Collapsed">
                                <TextBox x:Name="KeyPemBox" AcceptsReturn="True" Height="110"
                                         TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PlaceholderText="-----BEGIN OPENSSH PRIVATE KEY-----  (вставь содержимое приватного ключа)" />
                                <PasswordBox x:Name="KeyPassBox"
                                             PlaceholderText="парольная фраза ключа (если есть)" />
                            </StackPanel>

                            <TextBlock Text="Удалённая папка для архивов" FontSize="12"
                                       Foreground="{StaticResource EbTextDimBrush}" Margin="0,4,0,0" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RemoteDirBox" Grid.Column="0" Text="." />
                                <Button x:Name="BrowseBtn" Grid.Column="1" Content="Обзор…"
                                        CornerRadius="10" Click="BrowseBtn_Click" />
                            </Grid>

                            <!-- Дерево удалённых папок (ленивая подгрузка по раскрытию узла) -->
                            <Border x:Name="TreePanel" Visibility="Collapsed" CornerRadius="12"
                                    Background="#0DFFFFFF"
                                    BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                                    Padding="6">
                                <TreeView x:Name="FolderTree" MaxHeight="220"
                                          SelectionMode="None" CanDragItems="False"
                                          CanReorderItems="False" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <Button x:Name="TestBtn" Content="Тест" CornerRadius="12"
                                    Padding="22,8" Click="TestBtn_Click" />
                            <Button x:Name="SaveBtn" CornerRadius="12" Padding="22,8"
                                    Style="{StaticResource EbAccentButtonStyle}"
                                    Click="SaveBtn_Click">
                                <TextBlock Text="Сохранить" FontWeight="SemiBold" Foreground="#1A0F22" />
                            </Button>
                            <Button x:Name="DeleteBtn" Content="Удалить" CornerRadius="12"
                                    Padding="22,8" Foreground="{StaticResource EbErrBrush}"
                                    Visibility="Collapsed" Click="DeleteBtn_Click" />
                            <Button x:Name="CloseEditorBtn" Content="Закрыть" CornerRadius="12"
                                    Padding="22,8" Click="CloseEditorBtn_Click"
                                    Foreground="{StaticResource EbTextDimBrush}"
                                    ToolTipService.ToolTip="Закрыть без сохранения" />
                        </StackPanel>

                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
