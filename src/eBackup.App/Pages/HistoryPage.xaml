<Page
    x:Class="eBackup.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:eBackup.App.Pages">

    <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Слева: список запусков ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="История" FontSize="26" FontWeight="SemiBold" />
                <Button x:Name="RefreshBtn" Grid.Column="1" CornerRadius="10" Padding="9,7"
                        VerticalAlignment="Center" Click="RefreshBtn_Click"
                        ToolTipService.ToolTip="Обновить список запусков">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
            </Grid>

            <ListView x:Name="RunList" Grid.Row="1" SelectionMode="Single"
                      SelectionChanged="RunList_SelectionChanged"
                      ItemContainerStyle="{StaticResource EbNavItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="pages:RunItem">
                        <Grid Margin="0,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource EbTextDimBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind StatusGlyph}"
                                       Foreground="{x:Bind StatusBrush}"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ===== Справа: деталь запуска с полным логом ===== -->
        <Grid Grid.Column="1">
            <TextBlock x:Name="EmptyHint"
                       Text="Выбери запуск слева — здесь будет его полный лог"
                       Foreground="{StaticResource EbTextDimBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <Border x:Name="Detail" Visibility="Collapsed" CornerRadius="16"
                    Background="{StaticResource EbCardBrush}"
                    BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                    Padding="20">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="DetailTitle" Grid.Row="0"
                               FontSize="18" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailMeta" Grid.Row="1" FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource EbTextDimBrush}" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="DetailStatus" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Content="Скопировать лог" CornerRadius="10"
                                Click="CopyLog_Click" />
                    </StackPanel>

                    <!-- Полный лог с таймкодами. Нативный read-only TextBox рендерит только
                         видимую область — и колесо, и ползунок, и горизонтальная прокрутка
                         работают плавно даже на десятках тысяч строк (в отличие от TextBlock,
                         который раскладывал весь текст сразу). Полный текст — «Открыть лог-файл». -->
                    <Border Grid.Row="3" CornerRadius="12" Background="#0DFFFFFF"
                            BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                            Padding="6">
                        <TextBox x:Name="LogText" IsReadOnly="True" IsSpellCheckEnabled="False"
                                 FontFamily="Consolas" FontSize="12"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource EbTextDimBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
