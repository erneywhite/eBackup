<Window
    x:Class="eBackup.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Grid x:Name="RootGrid" Background="{StaticResource EbBackgroundBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccel_Invoked" />
            <!-- Клавиша Browser Back (VK 166) добавляется в коде: в enum VirtualKey имени нет -->
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <!-- Иконка в трее: живёт, пока работает приложение (в т.ч. со скрытым окном) -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="eBackup"
                        NoLeftClickDelay="True"
                        ContextMenuMode="SecondWindow">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="e"
                                        FontWeight="Bold"
                                        FontSize="46"
                                        Foreground="#1A0F22"
                                        Background="#C97DF6" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Открыть eBackup" Click="TrayOpen_Click" />
                    <MenuFlyoutItem Text="Сделать бэкап…" Click="TrayBackup_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Выход" Click="TrayExit_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- ===== Аврора-фон: три мягких цветных пятна за всем интерфейсом ===== -->
        <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
            <Ellipse Width="900" Height="620" Canvas.Left="-220" Canvas.Top="-180">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2EC97DF6" Offset="0" />
                        <GradientStop Color="#00C97DF6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="760" Height="540" Canvas.Left="660" Canvas.Top="-160">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#24FF6DC8" Offset="0" />
                        <GradientStop Color="#00FF6DC8" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="900" Height="640" Canvas.Left="240" Canvas.Top="380">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1A7DF9FF" Offset="0" />
                        <GradientStop Color="#007DF9FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Невидимая полоса перетаскивания окна поверх верхней кромки.
             Брендинг под ней некликабелен (IsHitTestVisible=False), так что
             окно таскается и за лого. -->
        <Grid x:Name="TitleBarDragArea" Grid.Row="0" Height="44"
              VerticalAlignment="Top" Background="Transparent" />

        <!-- ===== Контент: сайдбар + рабочая область ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Сайдбар -->
            <Grid Grid.Column="0" Padding="12,10,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Брендинг (как в eCoda — верх сайдбара).
                     LogoSlot 44×44: сюда позже встанет Image с лого от художницы. -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11" Margin="6,2,6,16"
                            IsHitTestVisible="False">
                    <Border x:Name="LogoSlot" Width="44" Height="44" CornerRadius="12"
                            Background="{StaticResource EbCardBrush}"
                            BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="e" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource EbAccentGradient}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,-3,0,0" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1" MaxWidth="130">
                        <TextBlock Text="eBackup" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource EbAccentGradient}" />
                        <TextBlock Text="бэкапы, которые переезжают с тобой" FontSize="10"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource EbTextDimBrush}" />
                    </StackPanel>
                </StackPanel>

                <ListView x:Name="Nav" Grid.Row="1" SelectionMode="Single"
                          SelectionChanged="Nav_SelectionChanged" IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource EbNavItemStyle}">
                    <ListViewItem Tag="overview" IsSelected="True">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" />
                            <TextBlock Text="Обзор" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="modules">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE71D;" FontSize="16" />
                            <TextBlock Text="Модули" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="storage">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEDA2;" FontSize="16" />
                            <TextBlock Text="Хранилища" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="archives">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                            <TextBlock Text="Архивы" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="schedule">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE787;" FontSize="16" />
                            <TextBlock Text="Расписание" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>

                <!-- Настройки прижаты к низу, как в eCoda -->
                <Button x:Name="SettingsBtn" Grid.Row="2" Click="SettingsBtn_Click"
                        Background="Transparent" BorderThickness="0" CornerRadius="12"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <TextBlock Text="Настройки" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Рабочая область: страницы (Обзор/Модули/Хранилища/Архивы) -->
            <Frame x:Name="ContentFrame" Grid.Column="1" Margin="8,36,24,8" />

            <!-- Глобальная «назад» (Alt+←, Browser Back, боковая кнопка мыши) -->
            <Button x:Name="GlobalBackBtn" Grid.Column="1" Width="36" Height="30"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4,0,0"
                    CornerRadius="10" Padding="0" Visibility="Collapsed"
                    Background="{StaticResource EbCardBrush}"
                    BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                    Click="GlobalBack_Click"
                    ToolTipService.ToolTip="Назад (Alt+← или боковая кнопка мыши)">
                <FontIcon Glyph="&#xE72B;" FontSize="12" />
            </Button>
        </Grid>

        <!-- ===== Нижняя панель-статус (аналог плеера eCoda) =====
             Во время бэкапа сама панель работает прогрессбаром: градиентная
             заливка плавно заполняет её по фазам и тает по завершении. -->
        <Border Grid.Row="1" Margin="12,0,12,12" CornerRadius="16"
                Background="{StaticResource EbCardBrush}"
                BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1">
            <Grid>
                <Rectangle x:Name="ProgressFill" Fill="{StaticResource EbAccentGradient}"
                           Opacity="0" RadiusX="16" RadiusY="16" IsHitTestVisible="False"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="FillScale" ScaleX="0" />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Grid VerticalAlignment="Center" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StatusTitle" Text="Готов к работе" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusSub" Text="последний бэкап: ещё не выполнялся" FontSize="12"
                                   Foreground="{StaticResource EbTextDimBrush}" />
                    </StackPanel>
                    <Button x:Name="BackupBtn" Grid.Column="1" Height="44" Padding="28,0" CornerRadius="22"
                            Background="{StaticResource EbAccentGradient}" BorderThickness="0"
                            Click="BackupBtn_Click">
                        <TextBlock Text="Сделать бэкап" FontWeight="SemiBold" Foreground="#1A0F22" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
