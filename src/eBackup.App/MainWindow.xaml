<Window
    x:Class="eBackup.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Grid x:Name="RootGrid" Background="{StaticResource EbBackgroundBrush}"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccel_Invoked" />
            <!-- Клавиша Browser Back (VK 166) добавляется в коде: в enum VirtualKey имени нет -->
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <!-- Иконка в трее: живёт, пока работает приложение (в т.ч. со скрытым окном).
             Трей принимает только .ico (png-источник не переваривает). -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="ms-appx:///Assets/app.ico"
                        ToolTipText="eBackup"
                        NoLeftClickDelay="True"
                        ContextMenuMode="SecondWindow">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="TrayOpen" Text="Открыть eBackup" Click="TrayOpen_Click" />
                    <MenuFlyoutItem x:Uid="TrayBackup" Text="Сделать бэкап…" Click="TrayBackup_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="TrayExit" Text="Выход" Click="TrayExit_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- ===== Аврора-фон: три мягких цветных пятна за всем интерфейсом ===== -->
        <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
            <Ellipse Width="900" Height="620" Canvas.Left="-220" Canvas.Top="-180">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2EC97DF6" Offset="0" />
                        <GradientStop Color="#00C97DF6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="760" Height="540" Canvas.Left="660" Canvas.Top="-160">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#24FF6DC8" Offset="0" />
                        <GradientStop Color="#00FF6DC8" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="900" Height="640" Canvas.Left="240" Canvas.Top="380">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1A7DF9FF" Offset="0" />
                        <GradientStop Color="#007DF9FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Невидимая полоса перетаскивания окна поверх верхней кромки.
             Брендинг под ней некликабелен (IsHitTestVisible=False), так что
             окно таскается и за лого. -->
        <Grid x:Name="TitleBarDragArea" Grid.Row="0" Height="44"
              VerticalAlignment="Top" Background="Transparent" />

        <!-- ===== Контент: сайдбар + рабочая область ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Сайдбар -->
            <Grid Grid.Column="0" Padding="12,10,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Брендинг: крупное лого, вордмарк и слоган; табы — ниже. -->
                <StackPanel Grid.Row="0" Spacing="8" Margin="6,10,6,18"
                            IsHitTestVisible="False" HorizontalAlignment="Center">
                    <Border Width="96" Height="96" CornerRadius="22" HorizontalAlignment="Center">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"
                                        ImageSource="ms-appx:///Assets/logo.png" />
                        </Border.Background>
                    </Border>
                    <TextBlock Text="eBackup" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource EbAccentGradient}" />
                    <TextBlock x:Uid="BrandTagline" Text="бэкапы, которые переезжают с тобой" FontSize="10.5"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="150"
                               HorizontalAlignment="Center" Margin="0,-4,0,0"
                               Foreground="{StaticResource EbTextDimBrush}" />
                </StackPanel>

                <ListView x:Name="Nav" Grid.Row="1" SelectionMode="Single"
                          SelectionChanged="Nav_SelectionChanged" IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource EbNavItemStyle}">
                    <ListViewItem Tag="overview" IsSelected="True">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" />
                            <TextBlock x:Uid="NavOverview" Text="Обзор" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="modules">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE71D;" FontSize="16" />
                            <TextBlock x:Uid="NavModules" Text="Модули" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="storage">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEDA2;" FontSize="16" />
                            <TextBlock x:Uid="NavStorage" Text="Хранилища" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="archives">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                            <TextBlock x:Uid="NavArchives" Text="Архивы" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="schedule">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE787;" FontSize="16" />
                            <TextBlock x:Uid="NavSchedule" Text="Расписание" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="history">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE81C;" FontSize="16" />
                            <TextBlock x:Uid="NavHistory" Text="История" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>

                <!-- Настройки прижаты к низу, как в eCoda -->
                <Button x:Name="SettingsBtn" Grid.Row="2" Click="SettingsBtn_Click"
                        Background="Transparent" BorderThickness="0" CornerRadius="12"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <TextBlock x:Uid="NavSettings" Text="Настройки" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Рабочая область: страницы (Обзор/Модули/Хранилища/Архивы).
                 Встроенный переход выключен — направленный слайд делается кодом
                 в OnFrameNavigated (вниз по списку вкладок → контент снизу, вверх → сверху). -->
            <Frame x:Name="ContentFrame" Grid.Column="1" Margin="8,36,24,8">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <SuppressNavigationTransitionInfo />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>

        </Grid>

        <!-- ===== Нижняя панель-статус (аналог плеера eCoda) =====
             Во время бэкапа сама панель работает прогрессбаром: градиентная
             заливка плавно заполняет её по фазам и тает по завершении. -->
        <!-- Акцент-свечение под нижней панелью: мягкий виолет-ореол (в духе «авроры»), за самой панелью.
             Градиент гаснет до полного нуля у краёв (RadiusX/Y ≤ 0.5..0.55 + промежуточные стопы) —
             чтобы не было резкой границы при отсечении прямоугольником. -->
        <Border Grid.Row="1" Margin="0,-24,0,0" CornerRadius="40" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.55">
                    <GradientStop Color="#38C97DF6" Offset="0" />
                    <GradientStop Color="#1CC97DF6" Offset="0.42" />
                    <GradientStop Color="#06C97DF6" Offset="0.74" />
                    <GradientStop Color="#00C97DF6" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Border Grid.Row="1" Margin="12,0,12,12" CornerRadius="16"
                Background="{StaticResource EbCardBrush}"
                BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1">
            <Grid x:Name="BarRoot">
                <!-- «Жидкий» прогресс: заливка во всю высоту, «вода» — на правом
                     краю-фронте: колышущийся мениск (пружинная модель по вертикали,
                     60 fps) и пузырьки, всплывающие ВНУТРИ жидкости. Геометрия и
                     пузырьки обновляются кодом каждый кадр; скруглённый
                     Composition-клип (в коде) прячет всё в углах панели. -->
                <Grid x:Name="LiquidFill" Opacity="0" IsHitTestVisible="False">
                    <Path x:Name="WaterBack" Fill="#FF6DC8" Opacity="0.10" />
                    <Path x:Name="WaterFront" Fill="{StaticResource EbAccentGradient}" Opacity="0.22" />
                    <Canvas x:Name="BubblesLayer" />
                </Grid>

                <Grid VerticalAlignment="Center" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StatusTitle" x:Uid="Main_StatusTitle" Text="Готов к работе" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusSub" x:Uid="Main_StatusSub" Text="последний бэкап: ещё не выполнялся" FontSize="12"
                                   Foreground="{StaticResource EbTextDimBrush}" />
                        <!-- Уведомление о новой версии (центр уведомлений) → ведёт в «Настройки». -->
                        <HyperlinkButton x:Name="UpdateHintBtn" Visibility="Collapsed" Padding="0"
                                         FontSize="12" Click="UpdateHint_Click" />
                    </StackPanel>
                    <Button x:Name="BackupBtn" Grid.Column="1" Height="44" Padding="28,0" CornerRadius="22"
                            Style="{StaticResource EbAccentButtonStyle}"
                            Click="BackupBtn_Click">
                        <TextBlock x:Name="BackupBtnText" x:Uid="Main_BackupBtnText" Text="Сделать бэкап" FontWeight="SemiBold" Foreground="#1A0F22" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
