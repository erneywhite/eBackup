<Window
    x:Class="eBackup.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource EbBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <!-- ===== Аврора-фон: три мягких цветных пятна за всем интерфейсом ===== -->
        <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
            <Ellipse Width="900" Height="620" Canvas.Left="-220" Canvas.Top="-180">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2EC97DF6" Offset="0" />
                        <GradientStop Color="#00C97DF6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="760" Height="540" Canvas.Left="660" Canvas.Top="-160">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#24FF6DC8" Offset="0" />
                        <GradientStop Color="#00FF6DC8" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="900" Height="640" Canvas.Left="240" Canvas.Top="380">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1A7DF9FF" Offset="0" />
                        <GradientStop Color="#007DF9FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- ===== Кастомный тёмный тайтлбар ===== -->
        <Grid x:Name="TitleBarDragArea" Grid.Row="0" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <!-- Слот под лого: сюда позже встанет картинка (Image) от художницы.
                     Пока — временная монограмма в стиле приложения. -->
                <Border x:Name="LogoSlot" Width="26" Height="26" CornerRadius="8"
                        Background="{StaticResource EbCardBrush}"
                        BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="e" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource EbAccentGradient}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,-2,0,0" />
                </Border>
                <TextBlock Text="eBackup" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource EbAccentGradient}" />
                <TextBlock Text="бэкапы, которые переезжают с тобой" FontSize="12"
                           Foreground="{StaticResource EbTextDimBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ===== Контент: сайдбар + рабочая область ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Сайдбар -->
            <Grid Grid.Column="0" Padding="12,8,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView x:Name="Nav" Grid.Row="0" SelectionMode="Single"
                          SelectionChanged="Nav_SelectionChanged" IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource EbNavItemStyle}">
                    <ListViewItem Tag="overview" IsSelected="True">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" />
                            <TextBlock Text="Обзор" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="modules">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE71D;" FontSize="16" />
                            <TextBlock Text="Модули" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="storage">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEDA2;" FontSize="16" />
                            <TextBlock Text="Хранилища" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="archives">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                            <TextBlock Text="Архивы" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>

                <!-- Настройки прижаты к низу, как в eCoda -->
                <ListView Grid.Row="1" SelectionMode="None"
                          ItemContainerStyle="{StaticResource EbNavItemStyle}">
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="Настройки" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Grid>

            <!-- Рабочая область (G-0: заглушка с карточками для оценки стиля) -->
            <ScrollViewer Grid.Column="1" Padding="8,0,24,8">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="PageTitle" Text="Обзор" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" />

                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- Карточка-образец 1 -->
                        <Border Width="210" Height="120" CornerRadius="16"
                                Background="{StaticResource EbCardBrush}"
                                BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                                Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="OBS Studio" FontWeight="SemiBold" />
                                <TextBlock Text="встроенный модуль" FontSize="12"
                                           Foreground="{StaticResource EbTextDimBrush}" />
                                <TextBlock Text="✓ включён" FontSize="12" Foreground="#7CE3A8" />
                            </StackPanel>
                        </Border>

                        <!-- Карточка-образец 2 -->
                        <Border Width="210" Height="120" CornerRadius="16"
                                Background="{StaticResource EbCardBrush}"
                                BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                                Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="NAS (SFTP)" FontWeight="SemiBold" />
                                <TextBlock Text="хранилище" FontSize="12"
                                           Foreground="{StaticResource EbTextDimBrush}" />
                                <TextBlock Text="✓ подключено" FontSize="12" Foreground="#7CE3A8" />
                            </StackPanel>
                        </Border>

                        <!-- Карточка «добавить» -->
                        <Border Width="120" Height="120" CornerRadius="16"
                                Background="Transparent"
                                BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                                Padding="16">
                            <TextBlock Text="+" FontSize="34" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource EbTextDimBrush}" />
                        </Border>
                    </ItemsControl>

                    <TextBlock Text="(G-0: каркас для оценки стиля — функциональность подключим в G-1+)"
                               FontSize="12" Foreground="{StaticResource EbTextDimBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Нижняя панель-статус (аналог плеера eCoda) ===== -->
        <Border Grid.Row="2" Margin="12,0,12,12" CornerRadius="16"
                Background="{StaticResource EbCardBrush}"
                BorderBrush="{StaticResource EbCardBorderBrush}" BorderThickness="1"
                Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Готов к работе" FontWeight="SemiBold" />
                    <TextBlock Text="последний бэкап: ещё не выполнялся" FontSize="12"
                               Foreground="{StaticResource EbTextDimBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Height="44" Padding="28,0" CornerRadius="22"
                        Background="{StaticResource EbAccentGradient}" BorderThickness="0">
                    <TextBlock Text="Сделать бэкап" FontWeight="SemiBold" Foreground="#1A0F22" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
