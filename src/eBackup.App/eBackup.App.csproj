<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>eBackup.App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Незапакованное приложение (без MSIX): запускается обычным exe -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Носим рантайм Windows App SDK с собой — не требуем установки у пользователя -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.0</Version>
    <Authors>Erney White</Authors>
    <Company>Erney White</Company>
    <Product>eBackup</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- WinUI unpackaged: dotnet publish не копирует app-PRI (eBackup.App.pri),
       без него ms-appx-ресурсы и XAML не грузятся. Копируем вручную. -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('$(TargetDir)$(TargetName).pri')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.9" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\eBackup.Storage.Sftp\eBackup.Storage.Sftp.csproj" />
    <ProjectReference Include="..\eBackup.Security\eBackup.Security.csproj" />
    <ProjectReference Include="..\eBackup.Core\eBackup.Core.csproj" />
    <ProjectReference Include="..\eBackup.Modules.Obs\eBackup.Modules.Obs.csproj" />
    <ProjectReference Include="..\eBackup.Modules.VTubeStudio\eBackup.Modules.VTubeStudio.csproj" />
    <ProjectReference Include="..\eBackup.Storage\eBackup.Storage.csproj" />
    <ProjectReference Include="..\eBackup.Ipc\eBackup.Ipc.csproj" />
  </ItemGroup>

</Project>
